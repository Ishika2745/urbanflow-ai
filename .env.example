# ==============================================================================
# UrbanFlow AI - Environment Configuration Template
# DataNova 2026: Problem Statement DN-DS-01
# Copy this file to .env and configure local/production overrides.
# NOTE: UrbanFlow AI uses 100% open geospatial data; NO PAID API KEYS REQUIRED.
# ==============================================================================

# Application Environment (development / production)
URBANFLOW_ENV=production

# Logging Level (DEBUG / INFO / WARNING / ERROR)
URBANFLOW_LOG_LEVEL=INFO

# Target Metropolitan City (default: mumbai)
URBANFLOW_CITY=mumbai

# Coordinate Reference System (CRS)
PROJECTED_CRS=EPSG:32643
DISPLAY_CRS=EPSG:4326

# Data Directory Paths (defaults to ./data)
# DATA_DIR=./data

# Planning & Catchment Defaults
SERVICE_RADIUS_METERS=800.0
DEFAULT_BUDGET=8
RANDOM_SEED=42

# Multi-Objective Fitness Evaluation Default Weights
POPULATION_COVERAGE_WEIGHT=0.40
EQUITY_WEIGHT=0.35
COST_WEIGHT=0.25

# Optional: Map Tile Key (CartoDB/Mapbox) - Leave empty to use OpenStreetMap
# MAP_TILES_API_KEY=
